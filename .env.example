# ── Database (MongoDB) ─────────────────────────────────
# Atlas example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# MongoDB must be a replica set (Atlas always is). Then run: npm run db:push   (first time / after schema changes)
MONGODB_URI=""
MONGODB_DB="nyati_procurement"

# ── Core ───────────────────────────────────────────────
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# ── Vendor links ───────────────────────────────────────
# Public https address vendors open from outside your network (defaults to APP_URL).
# Links look like: <VENDOR_PORTAL_URL>/vendor/rfq/<token>  and  <VENDOR_PORTAL_URL>/vendor/po/<token>
VENDOR_PORTAL_URL=""
# RFQ links keep working this many hours after the quotation deadline (read-only after the deadline)
VENDOR_LINK_GRACE_HOURS="24"
# PO links (accept / dispatch updates) stay valid this many days after the PO is sent
VENDOR_PO_LINK_DAYS="120"

# ── Demo mode ──────────────────────────────────────────
# true → emails are NOT sent; they appear in the Demo Outbox. Can be toggled in System Settings.
DEMO_MODE="true"

# ── Email ──────────────────────────────────────────────
# EMAIL_PROVIDER: resend | smtp
EMAIL_PROVIDER="smtp"
EMAIL_FROM="NYATI Procurement <procurement@nyati.example>"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# ── Quotation reading (Google Gemini) ──────────────────
# Without a key, a rule-based extractor is used and scanned PDFs / photos go to manual review.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# ── File storage ───────────────────────────────────────
# STORAGE_DRIVER: local | s3   (local writes to ./.data/uploads)
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── Distance / geocoding ───────────────────────────────
# MAPS_PROVIDER: google | ors | haversine
MAPS_PROVIDER="haversine"
GOOGLE_MAPS_API_KEY=""
ORS_API_KEY=""

# ── Market rates ───────────────────────────────────────
# MARKET_RATE_PROVIDER: tavily | serper | demo
MARKET_RATE_PROVIDER="demo"
TAVILY_API_KEY=""
SERPER_API_KEY=""

# ── Background jobs ────────────────────────────────────
# Shared secret for /api/cron (an external scheduler can call it every minute)
CRON_SECRET="change-me"
