{
  "name": "nyati-procurement",
  "version": "1.0.0",
  "private": true,
  "description": "NYATI project-based Inventory & Procurement Automation",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:push": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/prisma.mjs db push",
    "db:seed": "npm run db:push -- --skip-generate && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON prisma/seed.ts",
    "db:sample": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON prisma/seed.ts --keep",
    "create-admin": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/create-admin.mjs",
    "test-email": "node scripts/send-test-email.mjs",
    "db:studio": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/prisma.mjs studio",
    "test": "vitest run",
    "test:flow": "vitest run --mode integration",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=22.3"
  },
  "prisma": {
    "seed": "node prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "5.22.0",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@tanstack/react-table": "^8.20.5",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "docxtemplater": "^3.71.1",
    "lucide-react": "^0.453.0",
    "mammoth": "^1.8.0",
    "next": "14.2.35",
    "next-auth": "^4.24.10",
    "nodemailer": "^7.0.7",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pizzip": "^3.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "recharts": "^2.13.3",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.6",
    "@types/nodemailer": "^6.4.16",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.49",
    "prisma": "5.22.0",
    "rollup": "npm:@rollup/wasm-node@^4.67.4",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
