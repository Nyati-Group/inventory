# ── Dependencies ───────────────────────────────────────
node_modules/
.pnpm-store/

# ── Next.js / build output ─────────────────────────────
.next/
out/
build/
dist/
next-env.d.ts
*.tsbuildinfo

# ── Secrets & local config (never commit) ──────────────
# Real keys live in .env; .env.example is the committed template.
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# ── Local data ─────────────────────────────────────────
# Uploaded quotations, challans, RFQ/PO PDFs (local storage driver)
.data/
uploads/

# ── Tests ──────────────────────────────────────────────
/coverage/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# ── Logs ───────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Deployment platforms ───────────────────────────────
.vercel/
.netlify/

# ── Editors & OS ───────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
